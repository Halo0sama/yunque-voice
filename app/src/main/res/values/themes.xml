<resources>
    <style name="Theme.YunqueVoice" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/lark_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">@color/lark_primary</item>
        <item name="colorOnPrimary">@color/lark_on_primary</item>
        <item name="colorPrimaryContainer">@color/lark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/lark_on_primary_container</item>
        <item name="colorSecondary">@color/lark_secondary</item>
        <item name="colorSecondaryContainer">@color/lark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lark_on_secondary_container</item>
        <item name="colorSurface">@color/lark_surface</item>
        <item name="colorOnSurface">@color/lark_on_surface</item>
        <item name="colorSurfaceVariant">@color/lark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/lark_on_surface_variant</item>
        <item name="colorOutline">@color/lark_outline</item>
        <item name="colorOutlineVariant">@color/lark_outline_variant</item>
        <item name="android:colorBackground">@color/lark_surface</item>
        <item name="android:textColorPrimary">@color/lark_on_surface</item>
        <item name="android:textColorSecondary">@color/lark_on_surface_variant</item>
    </style>

    <style name="Theme.YunqueVoice.Monet" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/lark_surface</item>
        <item name="android:colorBackground">@color/lark_surface</item>
        <item name="android:textColorPrimary">@color/lark_on_surface</item>
        <item name="android:textColorSecondary">@color/lark_on_surface_variant</item>
    </style>
</resources>
